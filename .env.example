# Optional: enables "AI reasoning" in the assistant. Without it, the assistant
# answers offline from the knowledge base. Get a key at https://console.groq.com
GROQ_API_KEY=

# Optional: override the model (default: openai/gpt-oss-120b, falls back to llama-3.3-70b-versatile)
# GROQ_MODEL=openai/gpt-oss-120b
